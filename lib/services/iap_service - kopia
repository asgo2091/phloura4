import 'dart:io';
import 'package:in_app_purchase/in_app_purchase.dart';
import 'package:in_app_purchase_android/in_app_purchase_android.dart';
import 'package:in_app_purchase_storekit/in_app_purchase_storekit.dart';
import 'package:in_app_purchase_storekit/store_kit_wrappers.dart';

class IAPService {
  final InAppPurchase _inAppPurchase = InAppPurchase.instance;
  Function(PurchaseDetails)? _onVerifiedPurchase;
  Function(String)? _onError;

  void restorePurchases() async {
    await _inAppPurchase.restorePurchases();
  }

  // ignore: strict_top_level_inference
  initalize() async {
    // await getInAppPlans();
    listenToPurchaseUpdated();
    restorePurchases();

    // if(isPremium != 1){
    // Rxn<GetPlanDetailsApiCall> getPlanDetailsApiCall =
    //     Rxn<GetPlanDetailsApiCall>();
  }

  // Check if in-app purchase functionality is available
  Future<bool> isIAPAvailable() async {
    bool available = await _inAppPurchase.isAvailable();
    return available;
  }

  void listenToPurchaseUpdated() {
    final Stream<List<PurchaseDetails>> purchaseUpdated =
        _inAppPurchase.purchaseStream;
    purchaseUpdated.listen((purchases) async {
      for (var purchase in purchases) {
        _verifyPurchase(purchase);
      }
    });
  }

  Future<void> _verifyPurchase(PurchaseDetails purchase) async {
    if (purchase.status == PurchaseStatus.purchased) {
      // Verify purchase with your server if necessary
      await _deliverProduct(purchase);
      if (_onVerifiedPurchase != null) {
        _onVerifiedPurchase!(purchase);
      }
    } else if (purchase.status == PurchaseStatus.restored) {
      await _deliverProduct(purchase);
      if (_onVerifiedPurchase != null) {
        _onVerifiedPurchase!(purchase);
      }
    } else if (purchase.status == PurchaseStatus.error) {
      if (_onError != null) {
        _onError!(purchase.error?.message ?? 'Unknown error occurred');
      }
    } else if (purchase.status == PurchaseStatus.canceled) {
      if (purchase.pendingCompletePurchase) {
        await InAppPurchase.instance.completePurchase(purchase);
      }
    }
    if (purchase.pendingCompletePurchase) {
      await InAppPurchase.instance.completePurchase(purchase);
    }
  }

  Future<void> _deliverProduct(PurchaseDetails purchase) async {
    // Deliver the product (e.g., unlock feature, give coins, etc.)
  }

  Future<bool> checkSubscriptionStatus(String productId) async {
    final InAppPurchaseAndroidPlatformAddition androidAddition = _inAppPurchase
        .getPlatformAddition<InAppPurchaseAndroidPlatformAddition>();
    final QueryPurchaseDetailsResponse response = await androidAddition
        .queryPastPurchases();

    if (response.error != null) {
      // Handle query error
      return false;
    }

    for (PurchaseDetails purchase in response.pastPurchases) {
      if (purchase.productID == productId &&
          purchase.status == PurchaseStatus.purchased) {
        return true;
      }
    }
    return false;
  }

  Future<void> buyProduct(
    String productId,
    Function(PurchaseDetails) onVerifiedPurchase,
    Function(String) onError,
  ) async {
    _onVerifiedPurchase = onVerifiedPurchase;
    _onError = onError;

    final ProductDetailsResponse response = await _inAppPurchase
        .queryProductDetails({productId});

    if (response.error != null) {
      onError('Error querying product details: ${response.error!.message}');
      return;
    }

    if (response.productDetails.isEmpty) {
      onError('No product found with ID: $productId');
      return;
    }

    final product = response.productDetails.first;
    PurchaseParam purchaseParam = PurchaseParam(productDetails: product);

    if (Platform.isAndroid) {
      purchaseParam = GooglePlayPurchaseParam(
        productDetails: response.productDetails[0],
      );
    } else if (Platform.isIOS) {
      final InAppPurchaseStoreKitPlatformAddition iosPlatformAddition =
          _inAppPurchase
              .getPlatformAddition<InAppPurchaseStoreKitPlatformAddition>();
      await iosPlatformAddition.setDelegate(ExamplePaymentQueueDelegate());
    }

    _inAppPurchase.buyNonConsumable(purchaseParam: purchaseParam);
  }

  void dispose() {
    // _inAppPurchase.;
  }

  static DateTime expiryDateTime({
    required String productId,
    required DateTime currentDate,
  }) {
    if (productId == '2') {
      return currentDate.add(const Duration(days: 30));
    } else if (productId == '4') {
      return currentDate.add(const Duration(days: 365));
    } else {
      return DateTime(0);
    }
  }
}

class ExamplePaymentQueueDelegate implements SKPaymentQueueDelegateWrapper {
  @override
  bool shouldContinueTransaction(
    SKPaymentTransactionWrapper transaction,
    SKStorefrontWrapper storefront,
  ) {
    return true;
  }

  @override
  bool shouldShowPriceConsent() {
    return false;
  }
}
